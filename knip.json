{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "docs": {
      "project": ["**/*.{ts,tsx,mjs,astro,mdx}"]
    },
    "docs-kit": {
      "entry": ["components/*.astro"],
      "project": ["src/**/*.{ts,tsx,mdx,css}", "components/**/*.astro", "*.css"]
    }
  },
  "tags": ["-lintignore"]
}
