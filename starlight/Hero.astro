---
import { buttonClass, cn, type ButtonVariant } from "@bhodgson/design-system";

const { entry, siteTitle } = Astro.locals.starlightRoute;
const {
  title = entry.data.title,
  tagline,
  actions = [],
} = entry.data.hero ?? {};

const variants: Record<string, ButtonVariant> = {
  primary: "primary",
  secondary: "secondary",
  minimal: "link",
};
---

<header class="not-prose py-6 sm:py-10">
  <div class="border-l-4 border-accent pl-4 sm:pl-5">
    <p class="type-eyebrow text-accent">{siteTitle}</p>
    <h1
      id="_top"
      data-page-title
      class="mt-1 type-title sm:text-4xl"
      set:html={title}
    />
    {tagline && (
      <div
        class="mt-3 max-w-2xl text-lg leading-relaxed text-muted"
        set:html={tagline}
      />
    )}
    {actions.length > 0 && (
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {actions.map(({ link, text, variant = "primary" }) => (
          <a
            href={link}
            class={cn(
              buttonClass({ variant: variants[variant] }),
              "self-center no-underline",
            )}
          >
            {text}
          </a>
        ))}
      </div>
    )}
  </div>
</header>
